{
  "name": "stitch-mobile",
  "productName": "Stitch",
  "version": "0.3.0",
  "private": true,
  "description": "Stitch for Android — a remote for the Stitch desktop studio, with optional on-device text, image and voice generation.",
  "author": "Darker117",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "sync": "vite build && cap sync android",
    "apk": "vite build && cap sync android && node scripts/searxng.mjs && node scripts/native.mjs && node scripts/gradle.mjs assembleDebug",
    "apk:release": "vite build && cap sync android && node scripts/searxng.mjs && node scripts/native.mjs && node scripts/gradle.mjs assembleRelease",
    "searxng": "node scripts/searxng.mjs",
    "native": "node scripts/native.mjs",
    "catalog": "node scripts/catalog.mjs",
    "open": "cap open android",
    "icons": "node scripts/icons.mjs",
    "shot": "node scripts/shot.mjs"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-serif": "^5.3.0",
    "@lezer/highlight": "^1.2.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@xyflow/react": "^12.12.0",
    "@vitejs/plugin-react": "^5.2.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.48.0",
    "motion": "^13.4.4",
    "nanoid": "^6.0.1",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-router": "^7.18.4",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "zustand": "^5.0.15"
  },
  "dependencies": {
    "@capacitor-mlkit/barcode-scanning": "^8.2.1",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
